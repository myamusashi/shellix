{
	"nixpkgs": {
		"expr": "import <nixpkgs> { }"
	},
	"formatting": {
		"command": [
			"alejandra"
		]
	},
	"options": {
		"nixos": {
			"expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.nixos.options"
		},
		"home-manager": {
			"expr": "(builtins.getFlake (builtins.toString ./.)).homeConfigurations.myamusashi.options"
		}
	},
	"diagnostic": {
		"suppress": [
			"sema-extra-with"
		]
	}
}
