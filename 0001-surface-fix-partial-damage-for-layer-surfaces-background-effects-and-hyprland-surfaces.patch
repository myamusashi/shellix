+TEST_F(CBackgroundEffectTest, LayerSurfacePartialDamageWithActiveBlurRegion) {
+    const uint32_t         surfId = m_nextID++;
+    SP<CWLSurfaceResource> surf;
+    auto                   newSurfListener = PROTO::compositor->m_events.newSurface.listen([&](SP<CWLSurfaceResource> s) { surf = s; });
+    request(m_compositorId, 0, {surfId}); // wl_compositor.create_surface
+    ASSERT_TRUE(surf);
+
+    auto wire     = makeShared<CZwlrLayerSurfaceV1>(m_client, 4, m_nextID++);
+    auto resource = makeShared<CLayerShellResource>(wire, surf, "bg-effect-layer-test", m_monitor, ZWLR_LAYER_SHELL_V1_LAYER_TOP);
+    ASSERT_TRUE(resource->good());
+    wire->setDestroy([](CZwlrLayerSurfaceV1*) { ; });
+    wire->setOnDestroy([](CZwlrLayerSurfaceV1*) { ; });
+    resource->m_pending.desiredSize = {400, 300};
+    resource->m_current.desiredSize = {400, 300};
+    resource->m_configured          = true;
+    resource->m_mapped              = true;
+
+    auto layer             = Desktop::View::CLayerSurface::create(resource);
+    layerTestMapped(layer) = true;
+    layer->m_monitor       = m_monitor;
+    layer->m_geometry      = {50, 100, 400, 300};
+    layer->m_position      = {50, 100};
+    layer->positionAnimation()->setValueAndWarp({50, 100});
+    layer->sizeAnimation()->setValueAndWarp({400, 300});
+    layer->alpha()[Desktop::View::LS_ALPHA_FADE]->setValueAndWarp(1.F);
+    m_layerResources.emplace_back(resource);
+    m_layers.emplace_back(layer);
+
+    auto makeBuffer = [&](const Vector2D& size) {
+        auto buffer                  = makeShared<CBackgroundEffectTestBuffer>();
+        auto bufWire                 = makeShared<CWlBuffer>(m_client, 1, m_nextID++);
+        buffer->m_resource           = CWLBufferResource::create(bufWire);
+        buffer->m_resource->m_buffer = buffer;
+        buffer->size                 = size;
+        buffer->m_texture            = makeShared<CBackgroundEffectTestTexture>();
+        m_buffers.emplace_back(buffer);
+        return buffer;
+    };
+
+    auto buf400 = makeBuffer({400, 300});
+    request(surfId, 1, {wl_resource_get_id(buf400->m_resource->getResource()), 0, 0}); // wl_surface.attach
+    commit(surfId);
+    takeDamage();
+
+    // Attach ext-background-effect with blurRegion and commit once.
+    const uint32_t effectId = getBackgroundEffect(surfId);
+    const uint32_t region1  = createRegion({{0, 0, 200, 40}});
+    setBlurRegion(effectId, region1);
+    commit(surfId);
+    EXPECT_TRUE(pixman_region32_equal(takeDamage().pixman(), CRegion{50, 100, 200, 40}.pixman()));
+
+    // Subsequent commit with partial damage must NOT damage the full layer
+    // geometry.
+    request(surfId, 1, {wl_resource_get_id(buf400->m_resource->getResource()), 0, 0}); // wl_surface.attach
+    request(surfId, 2, {10, 20, 30, 15});                                              // wl_surface.damage
+    commit(surfId);
+    EXPECT_TRUE(pixman_region32_equal(takeDamage().pixman(), CRegion{60, 120, 30, 15}.pixman()));
+
+    // Shrinking surface size without layer-shell set_size must still damage the
+    // old geometry.
+    auto buf200 = makeBuffer({200, 150});
+    request(surfId, 1, {wl_resource_get_id(buf200->m_resource->getResource()), 0, 0}); // wl_surface.attach
+    commit(surfId);
+    EXPECT_TRUE(pixman_region32_equal(takeDamage().pixman(), CRegion{50, 100, 400, 300}.pixman()));
+}
