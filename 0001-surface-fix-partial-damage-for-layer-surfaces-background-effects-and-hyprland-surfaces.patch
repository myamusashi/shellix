+    layer->m_monitor       = m_monitor;
+    layer->m_geometry      = {50, 100, 400, 300};
+    layer->m_position      = {50, 100};
+    layer->positionAnimation()->setValueAndWarp({50, 100});
+    layer->sizeAnimation()->setValueAndWarp({400, 300});
+    layer->alpha()[Desktop::View::LS_ALPHA_FADE]->setValueAndWarp(1.F);
+    m_layerResources.emplace_back(resource);
