 src/protocols/BackgroundEffect.cpp   |  18 +-
 src/protocols/HyprlandSurface.cpp    |  51 +-
 src/protocols/HyprlandSurface.hpp    |   3 +-
 src/render/Renderer.cpp              |  40 +-
 src/render/Renderer.hpp              |   2 +
 tests/protocols/BackgroundEffect.cpp | 668 +++++++++++++++++++++++++++
 tests/protocols/HyprlandSurface.cpp  | 470 +++++++++++++++++++
