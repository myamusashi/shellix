{
	"colors": {
		<* for name, value in colors *>"{{name}}": "{{value.default.hex}}"<* if not loop.last *><* endif *>,
		<* endfor *>
		
		"primary_dimmed": "{{ colors.primary.default.rgba | set_lightness: -10.0 }}",
		"primary_bright": "{{ colors.primary.default.rgba | set_lightness: 10.0 }}",
		"secondary_dimmed": "{{ colors.secondary.default.rgba | set_lightness: -10.0 }}",
		"secondary_bright": "{{ colors.secondary.default.rgba | set_lightness: 10.0 }}",
		
		"primary_hover": "{{ colors.primary.default.rgba | auto_lightness: 8.0 }}",
		"secondary_hover": "{{ colors.secondary.default.rgba | auto_lightness: 8.0 }}",
		"tertiary_hover": "{{ colors.tertiary.default.rgba | auto_lightness: 8.0 }}",
		"surface_hover": "{{ colors.surface.default.rgba | auto_lightness: 4.0 }}",
		"surface_container_hover": "{{ colors.surface_container.default.rgba | auto_lightness: 4.0 }}",
		
		"primary_pressed": "{{ colors.primary.default.rgba | auto_lightness: 12.0 }}",
		"secondary_pressed": "{{ colors.secondary.default.rgba | auto_lightness: 12.0 }}",
		"tertiary_pressed": "{{ colors.tertiary.default.rgba | auto_lightness: 12.0 }}",
		"surface_pressed": "{{ colors.surface.default.rgba | auto_lightness: 6.0 }}",
		"surface_container_pressed": "{{ colors.surface_container.default.rgba | auto_lightness: 6.0 }}",
		
		"primary_container_pressed": "{{ colors.primary_container.default.rgba | auto_lightness: 10.0 }}",
		"secondary_container_pressed": "{{ colors.secondary_container.default.rgba | auto_lightness: 10.0 }}",
		"tertiary_container_pressed": "{{ colors.tertiary_container.default.rgba | auto_lightness: 10.0 }}",
		
		"primary_focus": "{{ colors.primary.default.rgba | set_alpha: 0.12 }}",
		"secondary_focus": "{{ colors.secondary.default.rgba | set_alpha: 0.12 }}",
		"tertiary_focus": "{{ colors.tertiary.default.rgba | set_alpha: 0.12 }}",
		
		"primary_overlay": "{{ colors.primary.default.rgba | set_alpha: 0.08 }}",
		"secondary_overlay": "{{ colors.secondary.default.rgba | set_alpha: 0.08 }}",
		"surface_overlay": "{{ colors.surface.default.rgba | set_alpha: 0.08 }}",
		"on_surface_overlay": "{{ colors.on_surface.default.rgba | set_alpha: 0.08 }}",
		
		"scrim_light": "{{ colors.scrim.default.rgba | set_alpha: 0.32 }}",
		"scrim_medium": "{{ colors.scrim.default.rgba | set_alpha: 0.56 }}",
		"scrim_heavy": "{{ colors.scrim.default.rgba | set_alpha: 0.72 }}",
		
		"on_surface_disabled": "{{ colors.on_surface.default.rgba | set_alpha: 0.38 }}",
		"on_surface_variant_disabled": "{{ colors.on_surface_variant.default.rgba | set_alpha: 0.38 }}",
		"primary_disabled": "{{ colors.primary.default.rgba | set_alpha: 0.38 }}",
		"on_primary_disabled": "{{ colors.on_primary.default.rgba | set_alpha: 0.38 }}",
		
		"surface_dragged": "{{ colors.surface.default.rgba | auto_lightness: 8.0 }}",
		"primary_dragged": "{{ colors.primary.default.rgba | auto_lightness: 16.0 }}"
	}
}
