+        let
           modsFilePath = "${cfg.profilesPath}/${profile.path}/chrome/sine-mods/mods.json";
 
-          updateSineModsScript =
-            pkgs.writeShellScript "zen-sine-mods-update-${profileName}"
-            ''
+          updateSineModsScript = pkgs.writeShellScript "zen-sine-mods-update-${profileName}" ''
               MODS_FILE="${modsFilePath}"
               SINE_MODS="${lib.concatStringsSep " " profile.sine.mods}"
               BASE_DIR="${cfg.profilesPath}/${profile.path}"
               MANAGED_FILE="$BASE_DIR/zen-sine-mods-nix-managed.json"
 
+            # Mods whose files ship with the configuration. Declared as JSON so the
+            # shell loop can walk them with the same jq tooling as store mods.
+            LOCAL_MODS_JSON='${
+              builtins.toJSON (
+                map (m: {
+                  inherit (m)
+                    id
+                    name
+                    style
+                    scripts
+                    ;
+                }) profile.sine.localMods
+              )
+            }'
+            LOCAL_IDS=$(echo "$LOCAL_MODS_JSON" | ${lib.getExe pkgs.jq} -r 'map(.id) | join(" ")')
+            ALL_MODS="$SINE_MODS $LOCAL_IDS"
+            # Interpolating the sources (not toString) keeps them as derivation
+            # inputs, so the store paths are protected and realized when this
+            # script runs. MOD_SRC is resolved from here, not from the JSON.
+            LOCAL_MOD_SOURCES='${
+              lib.concatMapStringsSep "\n" (m: "${m.id} ${m.source}") profile.sine.localMods
+            }'
+
               mkdir -p "$BASE_DIR/chrome/sine-mods"
 
               if [ ! -f "$MODS_FILE" ]; then
@@ -138,7 +202,7 @@ in {
               }
 
               for mod_id in $(echo "$PREV_STATE" | ${lib.getExe pkgs.jq} -r 'keys[]'); do
-                if [[ " $SINE_MODS " != *" $mod_id "* ]]; then
+                if [[ " $ALL_MODS " != *" $mod_id "* ]]; then
                   ${lib.getExe pkgs.jq} "del(.[\"$mod_id\"])" "$MODS_FILE" > "$MODS_FILE.tmp" && mv "$MODS_FILE.tmp" "$MODS_FILE"
                   rm -rf "$BASE_DIR/chrome/sine-mods/$mod_id"
                   echo "Removed sine mod $mod_id"
@@ -147,6 +211,55 @@ in {
 
               NEW_STATE="{}"
 
+              # Local mods: merge-copy the configuration-supplied files over the mod
+              # directory (vastctl-rendered outputs survive switches) and rewrite their
+              # mods.json entry unconditionally, so declared style/scripts always win.
+              # origin stays "store": getScripts() drops scripts from any mod without it.
+              mapfile -t LOCAL_SPECS < <(echo "$LOCAL_MODS_JSON" | ${lib.getExe pkgs.jq} -c '.[]')
+              for spec in "''${LOCAL_SPECS[@]}"; do
+                MOD_ID=$(echo "$spec" | ${lib.getExe pkgs.jq} -r '.id')
+                MOD_NAME=$(echo "$spec" | ${lib.getExe pkgs.jq} -r '.name')
+                MOD_SRC=$(grep "^$MOD_ID " <<<"$LOCAL_MOD_SOURCES" | cut -d' ' -f2-)
+                if [ -z "$MOD_SRC" ] || [ ! -d "$MOD_SRC" ]; then
+                  echo "zen-sine-mods: local mod '$MOD_ID' source missing in store: '$MOD_SRC'" >&2
+                  exit 1
+                fi
+                MOD_STYLE=$(echo "$spec" | ${lib.getExe pkgs.jq} -c '.style')
+                MOD_SCRIPTS=$(echo "$spec" | ${lib.getExe pkgs.jq} -c '.scripts')
+
+                if [[ " $SINE_MODS " == *" $MOD_ID "* ]]; then
+                  echo "zen-sine-mods: local mod id '$MOD_ID' collides with a store mod id" >&2
+                  exit 1
+                fi
+
+                MOD_DIR="$BASE_DIR/chrome/sine-mods/$MOD_ID"
+                mkdir -p "$MOD_DIR"
+                # Store files copy as 0444: re-enable writing so a re-switch can
+                # overwrite them (same convention as wrap-zen's postInstall).
+                chmod -R u+w "$MOD_DIR" 2>/dev/null || true
+                cp -r "$MOD_SRC/." "$MOD_DIR/"
+
+                ENTRY=$(${lib.getExe pkgs.jq} -cn \
+                  --arg id "$MOD_ID" \
+                  --arg name "$MOD_NAME" \
+                  --argjson style "$MOD_STYLE" \
+                  --argjson scripts "$MOD_SCRIPTS" '
+                  # getScripts() walks mod.scripts as a path -> options OBJECT;
+                  # a plain array would be skipped by flattenPathStructure.
+                  {id: $id, name: $name, enabled: true, "no-updates": true, origin: "store", style: $style}
+                  | (if ($scripts | length) > 0
+                     then .scripts = ($scripts | map({(.): {}}) | add // {})
+                     else . end)
+                ')
+                ${lib.getExe pkgs.jq} --arg id "$MOD_ID" --argjson entry "$ENTRY" \
+                  '.[$id] = $entry' "$MODS_FILE" > "$MODS_FILE.tmp" && mv "$MODS_FILE.tmp" "$MODS_FILE"
+
+                SRC_HASH=$(${pkgs.findutils}/bin/find "$MOD_SRC" -type f -print0 | sort -z | ${pkgs.findutils}/bin/xargs -0 -r sha256sum | sha256sum | cut -c1-64)
+                NEW_STATE=$(echo "$NEW_STATE" | ${lib.getExe pkgs.jq} -c \
+                  --arg id "$MOD_ID" --arg h "$SRC_HASH" \
+                  '.[$id] = {hash: $h, source: "local", etag: ""}')
+              done
+
               SINE_BASE="https://raw.githubusercontent.com/sineorg/store/main/mods"
               THEME_BASE="https://raw.githubusercontent.com/zen-browser/theme-store/main/themes"
 
@@ -439,12 +552,12 @@ in {
                 fi
               done
 
-              SINE_MODS_JSON=$(echo "$SINE_MODS" | tr ' ' '\n' | ${lib.getExe pkgs.jq} -R -s 'split("\n") | map(select(. != ""))')
+              SINE_MODS_JSON=$(echo "$ALL_MODS" | tr ' ' '\n' | ${lib.getExe pkgs.jq} -R -s 'split("\n") | map(select(. != ""))')
               echo "$NEW_STATE" | ${lib.getExe pkgs.jq} '.' > "$MANAGED_FILE"
 
               PREF_VALIDITY="{}"
               DEFAULT_PREFS="{}"
-              for mod_id in $SINE_MODS; do
+              for mod_id in $ALL_MODS; do
                 PREF_NAME=$(${lib.getExe pkgs.jq} -r --arg id "$mod_id" '.[$id].preferences // ""' "$MODS_FILE")
                 PREF_VALID=false
                 if [ -n "$PREF_NAME" ]; then
@@ -490,21 +603,20 @@ in {
                 echo "Error: Generated invalid JSON in $MODS_FILE"
                 exit 1
               fi
-            '';
+          '';
         in
-          nameValuePair profileName [
-            {
-              text = ''
-                ${updateSineModsScript}
-                if [[ "$?" -eq 0 ]]; then
-                  $VERBOSE_ECHO "zen-sine-mods: Updated sine mods for profile '${profileName}'"
-                else
-                  echo "zen-sine-mods: Failed to update sine mods for profile '${profileName}'!" >&2
-                fi
-              '';
-            }
-          ]
-      )
-      profilesWithSineMods;
+        nameValuePair profileName [
+          {
+            text = ''
+              ${updateSineModsScript}
+              if [[ "$?" -eq 0 ]]; then
