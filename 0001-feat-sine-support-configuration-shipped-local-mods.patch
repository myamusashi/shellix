diff --git a/tests/sine-local-mods.nix b/tests/sine-local-mods.nix
new file mode 100644
index 0000000..2b3c22f
--- /dev/null
+++ b/tests/sine-local-mods.nix
@@ -0,0 +1,110 @@
+# Local mods ship their files with the configuration instead of a store. The
+# updater must copy the source into the profile, write a store-origin mods.json
+# entry (getScripts() drops scripts from anything else), keep the id out of the
+# purge, and leave files it does not own (vastctl-rendered outputs) in place
+# across switches.
+{
+  pkgs,
+  zen-browser-flake,
+  ...
+}:
+let
+  modId = "nix-local-mod";
+
+  modSource = pkgs.runCommand "sine-local-mod-src" { } ''
+        mkdir -p $out
+        cat > $out/chrome.css <<'EOF'
+    :root {
+      --local-mod-marker: #00ff00;
+    }
+    EOF
+        cat > $out/content.css <<'EOF'
+    :root {
+      --local-content-marker: #00ff00;
+    }
+    EOF
+        cat > $out/probe.sys.mjs <<'EOF'
+    try {
+      Services.prefs.setBoolPref("nixtest.local.script.ran", true);
+    } catch (e) {}
+    EOF
+  '';
+in
+{
+  machineModules = [
+    {
+      virtualisation.memorySize = 2048;
+    }
+  ];
+
+  homeModule = {
+    imports = [ zen-browser-flake.homeModules.beta ];
+
+    programs.zen-browser = {
+      enable = true;
+      profiles.default = {
+        id = 0;
+
+        sine.enable = true;
+        sine.localMods = [
+          {
+            id = modId;
+            name = "Nix Local Mod";
+            source = modSource;
+            style = {
+              chrome = "chrome.css";
+              content = "content.css";
+            };
+            scripts = [ "probe.sys.mjs" ];
+          }
+        ];
+
+        settings = {
+          "zen.welcome-screen.seen" = true;
+          "browser.shell.checkDefaultBrowser" = false;
+        };
+      };
+    };
+  };
+
+  testScript = ''
+    import json
+
+    profile = "/home/testuser/.config/zen/default"
+    mods_dir = profile + "/chrome/sine-mods"
+    mod_dir = mods_dir + "/${modId}"
+
+    machine.succeed("systemctl restart home-manager-testuser.service")
+    machine.wait_for_unit("home-manager-testuser.service")
+
+    files = machine.succeed(f"ls {mod_dir}")
+    assert "chrome.css" in files, files
+    assert "content.css" in files, files
+    assert "probe.sys.mjs" in files, files
+
+    mods = json.loads(machine.succeed(f"cat {mods_dir}/mods.json"))
+    entry = mods["${modId}"]
+    assert entry["enabled"] is True, entry
+    assert entry["origin"] == "store", entry
+    assert entry["style"] == {"chrome": "chrome.css", "content": "content.css"}, entry
+    assert entry["scripts"] == {"probe.sys.mjs": {}}, entry
+
+    state = json.loads(machine.succeed(
+        f"cat {profile}/zen-sine-mods-nix-managed.json"))["${modId}"]
+    assert state["source"] == "local", state
+
+    # NOTE: the aggregator mods_dir/chrome.css is written by the Sine engine at
+    # runtime, not by the updater; its content is covered by tests/sine-mods.nix,
+    # which launches the browser.
+
+    # A rendered output the updater does not own must survive a re-switch.
+    machine.succeed(f"printf ':root {{ --rendered: #123456; }}' > {mod_dir}/rendered.css")
+    machine.succeed("systemctl restart home-manager-testuser.service")
+    machine.wait_for_unit("home-manager-testuser.service")
+
+    machine.succeed(f"test -f {mod_dir}/rendered.css")
+    machine.succeed(f"test -f {mod_dir}/probe.sys.mjs")
+    entry2 = json.loads(machine.succeed(f"cat {mods_dir}/mods.json"))["${modId}"]
+    assert entry2["style"] == {"chrome": "chrome.css", "content": "content.css"}, entry2
+  '';
+}
